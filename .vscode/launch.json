{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask: Run LMS",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["run", "--debug"],
      "env": {
        "FLASK_APP": "app.py",
        "FLASK_ENV": "development",
        "FLASK_DEBUG": "1"
      },
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "autoStartBrowser": false
    },
    {
      "name": "Python: app.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "autoStartBrowser": false
    }
  ]
}
